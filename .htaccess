<IfModule mod_rewrite.c>
    RewriteEngine On
    # Redirect everything to the public folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent sensitive files from being accessed
<Files .env>
    Order allow,deny
    Deny from all
</Files>

<Files composer.json>
    Order allow,deny
    Deny from all
</Files>

<Files composer.lock>
    Order allow,deny
    Deny from all
</Files>

<Files package.json>
    Order allow,deny
    Deny from all
</Files>
